{
  "name": "smolcode",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Local, private, offline-first autonomous coding agent desktop application",
  "author": "SmolCode Contributors",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx bench/runner.ts",
    "screenshots": "electron scripts/capture-screenshots.cjs",
    "icons": "electron scripts/generate-icons.js"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@tanstack/react-virtual": "^3.14.28",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.0",
    "lucide-react": "^1.79.0",
    "marked": "^18.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.22.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
